<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash shown while the OS/engine starts, before the animated
     MoneyTries splash_screen.dart takes over. Solid dark navy brand
     background with the MoneyTries logo centered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
