<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) enforces a system-level splash screen before
         the Flutter engine draws its first frame. We keep the brand background
         colour so there is no flash, but set the animation duration to 0 so
         the system splash exits immediately when Flutter is ready — handing
         off to the animated Flutter SplashScreen with no visible gap.
         The icon is still set so the launcher icon isn't shown as a fallback. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <!-- Exit the system splash as fast as possible so the Flutter
             animated splash screen is always the one the user sees. -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
